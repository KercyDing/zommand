.{
    .name = "zis",
    .version = "0.0.1",
    .about = "A tiny tool for better control over your Zig projects.",
    .commands = [
        .{
            .name = "fetch",
            .about = "Fetch a package and print hash",
            .args = [
                // Usage:
                // zis fetch <url>
                .positional(.{
                    .id = "url",
                    .help = "Package repository URL",
                    .required = true,
                }),
                // Usage:
                // zis fetch --save <url>
                // or:
                // zis fetch -s <url>
                .flag(.{
                    .id = "save",
                    .short = "s",
                    .help = "Print full dependency",
                }),
            ],
        },
        .{
            .name = "init",
            .about = "Initialize a project from a template",
            .args = [
                // Usage:
                // zis init <name>
                .positional(.{
                    .id = "name",
                    .help = "Project name",
                    .required = true,
                }),
                // Usage:
                // zis init <name> --template <TEMPLATE>
                // or:
                // zis init <name> -t <TEMPLATE>
                .option(.{
                    .id = "template",
                    .short = "t",
                    .help = "Template name to use or create (default: global)",
                    .default = "global",
                }),
            ],
        },
    ],
}
