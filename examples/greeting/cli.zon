.{
    .name = "greeting",
    .version = "0.0.1",
    .commands = .{
        .{
            .name = "print",
            .about = "Print hello world",
            .args = .{
                .{
                    .option = .{
                        .id = "name",
                        .help = "Name to greet",
                        .default = "world",
                    },
                },
            },
        },
    },
}
